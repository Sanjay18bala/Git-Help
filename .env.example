# Every value below is required. The README's "Set up" section says where each one comes from.

# GitHub OAuth App (README step 2). Callback URL: http://localhost:5173/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Slack app (README step 3)
# User OAuth Token, starts with xoxp- (OAuth & Permissions). Reads the channels you link.
SLACK_USER_TOKEN=
# Bot User OAuth Token, starts with xoxb- (OAuth & Permissions). DMs owners about late work.
SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope, starts with xapp- (Basic Information). Receives their replies.
SLACK_APP_TOKEN=

# Optional: cloud models instead of Ollama. These can also be set on the Settings page.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
